main:
ADDSP 5
PUSHIMMSTR "The rain in Spain falls"
STOREOFF 1
PUSHOFF 1
PUSHSP
PUSHIMM -1
ADD
POPFBR
DUP
PUSHIMM 0
SWAP
str_rev_loop:
DUP
PUSHIND
ISNIL
JUMPC str_rev_middle
SWAP
PUSHIMM 1
ADD
SWAP
PUSHIMM 1
ADD
JUMP str_rev_loop
str_rev_middle:
PUSHOFF 2
PUSHIMM -1
ADD
STOREOFF 2
PUSHOFF 1
PUSHIMM 1
ADD
MALLOC
str_rev_loop2:
DUP
PUSHOFF 2
PUSHIND
STOREIND
PUSHIMM 1
ADD
PUSHOFF 2
PUSHIMM -1
ADD
STOREOFF 2
PUSHOFF 2
PUSHOFF 0
LESS
JUMPC str_rev_ending
JUMP str_rev_loop2
str_rev_ending:
PUSHOFF 1
PUSHIMM -1
TIMES
ADD
STOREOFF 1
ADDSP -1
SWAP
ADDSP -1
PUSHIMM 0
POPFBR
STOREOFF 2
PUSHOFF 1
JUMP end_main_35
end_main_35:
STOREOFF 0
ADDSP -4
STOP